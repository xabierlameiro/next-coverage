{
  "name": "next-coverage",
  "version": "0.1.2",
  "description": "API surface coverage report for Next.js App Router projects: what you use, what would apply, what does not.",
  "keywords": [
    "nextjs",
    "app-router",
    "coverage",
    "api-surface",
    "audit",
    "cli"
  ],
  "license": "MIT",
  "author": "Xabier Lameiro",
  "homepage": "https://github.com/xabierlameiro/next-coverage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xabierlameiro/next-coverage.git"
  },
  "bugs": {
    "url": "https://github.com/xabierlameiro/next-coverage/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "next-coverage": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "fixtures": "node test-support/materialize.mjs",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepare": "husky >/dev/null 2>&1 || true"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "tinyglobby": "^0.2.15",
    "tsup": "^8.5.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  },
  "sideEffects": false
}
